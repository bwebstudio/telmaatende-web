# Endpoint do formulario de contacto.
# A Telma nao tem backend proprio: o formulario envia um POST para este URL.
# Use um servico tipo Formspree (https://formspree.io) ou equivalente.
#
# Exemplo com Formspree:
#   1. Crie um formulario em formspree.io e copie o endpoint.
#   2. Cole o endpoint aqui.
#   3. No Vercel, adicione a mesma variavel em Project Settings > Environment Variables.
#
# Se esta variavel estiver vazia, o formulario mostra uma mensagem a pedir configuracao.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# URL publico do site (usado em metadata, Open Graph e hreflang).
# Em producao no Vercel, defina o dominio final, por exemplo https://telmaatende.com
NEXT_PUBLIC_SITE_URL=https://telmaatende.com

# Origem da aplicacao do painel, onde vive a inscricao (/inscricao).
#
# Enquanto estiver vazia, os botoes dos planos continuam a apontar para o
# formulario de contacto e dizem "Falar connosco". Assim que for preenchida,
# passam a dizer "Comecar" e levam ao wizard, com o plano escolhido ja
# selecionado. Preencha-a quando a inscricao estiver mesmo aberta ao publico.
#
# Exemplo: https://painel.telmaatende.com
NEXT_PUBLIC_ONBOARDING_URL=https://painel.telmaatende.com
# Sólo la base, SIN /inscricao: signupUrl() añade la ruta y el plan.
# Con la ruta dentro sale /inscricao/inscricao, que es un 404 silencioso.
